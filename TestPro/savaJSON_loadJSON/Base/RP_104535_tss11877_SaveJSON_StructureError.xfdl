    </Objects>
    <Script type="xscript5.1"><![CDATA[this.btn_group_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.Dataset00.set_keystring("G:Company");	
};
this.btnLoadJSON_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var sJSON = this.taLoadJSON.value;
	try {
		this.Dataset00.loadJSON(sJSON);
	} catch(e) {
		trace("Dataset.loadJSON Exception : " + e);
		alert("Dataset.loadJSON Exception : " + e);
	}
};

this.btnSaveJSON_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var sJSON = this.Dataset00.saveJSON();
	//this.taSaveJSON.set_value(sJSON);
	this.Static00.set_text(sJSON);
};

this.btnCopySaveToLoad_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.taLoadJSON.set_value(this.taSaveJSON.value);
};

this.btnJSONparse_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var sJSON = this.taLoadJSON.value;
	try {
		var oJSON = JSON.parse(sJSON);
		trace("oJSON=[[[" + oJSON + "]]]");
		this.DataObject00.set_data(oJSON);
	} catch(e) {
		trace("JSON.parse Exception : " + e);
		alert("JSON.parse Exception : " + e);
	}
};

this.btnJSONstringify_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var oJSON = this.DataObject00.data;
	var sJSON = JSON.stringify(oJSON);
	this.taSaveJSON.set_value(sJSON);
};

this.btnClearDataset_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.Dataset00.clearData();
};

this.btnClearAllDataset_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.Dataset00.clear();
};

this.btnClearGroup_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.Dataset00.set_keystring("");	
};

this.btnCheckColumnInfo_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var iColCount = this.Dataset00.getColCount();
	var sColInfo = "";
	for(var i = 0; i < iColCount; i++) {
		var oColInfo = this.Dataset00.getColumnInfo(i);
		sColInfo += "" + oColInfo.name + " : type=" + oColInfo.type + "; size=" + oColInfo.size + "; prop=" + oColInfo.prop + "; sumtext=" + oColInfo.sumtext + "; datapath=" + oColInfo.datapath + ";\n";
	}
	sColInfo = "--- ColumnInfo ---------\n" + sColInfo + "---\n";
	trace(sColInfo);
	alert(sColInfo);
};

this.Button00_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	trace(this.Dataset00.saveXML());
};
]]></Script>
  </Form>
</FDL>
